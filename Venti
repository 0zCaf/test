function flingPart(hitter,part,soundId,lookVector,power)
	if part:IsDescendantOf(spoofChar) then return end

	power = power or 100

	local isOther = true
	local model = part:FindFirstAncestorOfClass("Model")
	if model then
		if isZinInstance(model) then return end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			isOther = false
			hum.Health = hum.Health - (hum.MaxHealth/4*(1+math.random()))

			for i,v in pairs(model:GetDescendants()) do
				if v:IsA("BasePart") then
					hitSound(v,soundId)
					v.Velocity = lookVector and lookVector*power or (v.Position - hitter.Position).Unit*power
				end
			end
		end
	end

	if isOther and not part.Anchored and not isZinInstance(part) then
		hitSound(part,soundId)
		part:BreakJoints()
		part.Velocity = lookVector and lookVector*power or (part.Position - hitter.Position)*power
		if part:IsA("Seat") or part:IsA("VehicleSeat") then part.Disabled = true end
	end
end

